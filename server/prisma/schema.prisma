// PPG Pulse — data model (SPEC §1)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Scope {
  org
  team
  own
}

enum HdisType {
  RADC
  RADF
  Internal
}

enum InterviewSession {
  mid
  end
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  sub         String
  scope       Scope
  isSystem    Boolean          @default(false)
  isProtected Boolean          @default(false)
  createdAt   DateTime         @default(now())
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  section    String
  capability String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, section, capability])
  @@index([roleId])
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  roleId        String
  team          String
  managerId     String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  role          Role           @relation(fields: [roleId], references: [id])
  manager       User?          @relation("Reports", fields: [managerId], references: [id])
  reports       User[]         @relation("Reports")
  overrides     UserOverride[]
  consultant    Consultant?
  hdisActivity  HdisActivity[]
  interviews    Interview[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([managerId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserOverride {
  id         String @id @default(cuid())
  userId     String
  section    String
  capability String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section, capability])
  @@index([userId])
}

model Consultant {
  id                 String                @id @default(cuid())
  userId             String                @unique
  pod                String
  eventsHosted       Int                   @default(0)
  eventsParticipated Int                   @default(0)
  insights           Int                   @default(0)
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  requirements       Requirement[]
  kpiTargets         KpiConsultantTarget[]
  logs               ConsultantLog[]
}

model Requirement {
  id        String     @id @default(cuid())
  code      String     @unique
  jdId      String?
  ownerId   String
  title     String
  client    String
  reqDate   String // ISO YYYY-MM-DD
  status    String // 'Active' | 'On Hold' | 'Closed'
  profiles  Int        @default(0)
  shortlist Int        @default(0)
  l1        Int        @default(0)
  l2        Int        @default(0)
  l3        Int        @default(0)
  onboard   Int        @default(0)
  owner     Consultant @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  hdis      Hdis?      @relation(fields: [jdId], references: [jdId])

  @@index([ownerId, reqDate])
  @@index([reqDate])
  @@index([jdId])
}

model Hdis {
  jdId         String                 @id
  title        String
  client       String
  type         HdisType
  openings     Int                    @default(1)
  status       String
  /// Free-text reason shown alongside "On Hold"/"Closed" statuses — e.g. "Hold By
  /// client", "Closed by VAYUZ". Not meaningful while status is "Active".
  statusReason String?
  /// Optional freeform note captured with the status, shown on the record detail page.
  remarks      String?
  priority     String                 @default("NA")
  confidence   String                 @default("Medium")
  reqDate      String // ISO YYYY-MM-DD
  jdLink       String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  owners       HdisOwner[]
  pipeline     HdisPipeline?
  attachments  HdisAttachment[]
  activity     HdisActivity[]
  requirements Requirement[]
  stageEvents  HdisStageEvent[]
  detail       HdisRequirementDetail?
  candidates   HdisCandidate[]

  @@index([reqDate])
  @@index([status])
}

/// The "BIG RAPYD Requirement Questionnaire" — the deeper intake details a requirement
/// needs before it's allowed to go "Active" (see hdis/service.ts's completeness check).
/// Every field is optional here so the questionnaire can be saved as a partial draft;
/// `isComplete` is recomputed and stored every time it's saved, from the subset of
/// fields the questionnaire itself marks as required.
model HdisRequirementDetail {
  jdId String @id
  hdis Hdis   @relation(fields: [jdId], references: [jdId], onDelete: Cascade)

  // Requirement overview
  bigMemberName        String?
  requirementsReceived Int?
  requirementName      String?
  engagementType       String?
  clientType           String?
  roleBackground       String?

  // Timeline & openings
  positionOpenDuration      String?
  hiringDeadline            String?
  interviewRoundsCount      Int?
  interviewRoundsDefinition String?
  positionsAlreadyFilled    Int?

  // Client's internal hiring effort
  clientAttemptedInternalHiring Boolean?
  internalHiringDuration        String?
  internalHiringChannels        String?
  internalHiringStageReached    String?
  internalHiringChallenges      String?
  ctcBlockerGap                 String?
  maxNoticePeriod               String?
  targetCompaniesSuggested      String?

  // Vendor & market info
  vayuzExclusive           Boolean?
  vendorCount              String?
  vendorsSharingProfiles   String?
  vendorSubmissionDuration String?
  duplicateProfileTimeline String?

  // Commercial & closure
  commercialRates    String?
  clientPocDetails   String?
  additionalInsights String?
  closureConfidence  String?
  exceptionNotes     String?
  atsUsed            String?

  isComplete Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

/// Named candidates submitted against a requirement — the granular data the
/// Performance Scorecard (recruiter closures, L2/L3 conversion, TAT, dropout rate,
/// tech-stack expertise, interview->offer / offer->joining ratios) reads from. This is
/// distinct from HdisPipeline, which only tracks aggregate R0-R5 headcounts per
/// requirement with no notion of who each person is or who submitted them.
model HdisCandidate {
  id          String   @id @default(cuid())
  jdId        String
  hdis        Hdis     @relation(fields: [jdId], references: [jdId], onDelete: Cascade)
  name        String
  techStack   String?
  /// The recruiter this candidate is attributed to — free text, matching
  /// HdisOwner.consultantOrName the same way the rest of HDIS attributes work.
  ownerName   String
  /// Highest pipeline stage this candidate has reached: 'R0'..'R5' (mirrors the
  /// existing HdisPipeline stage labels — R5 == Onboarded/Joined).
  stage       String   @default("R0")
  /// 'Active' | 'Offered' | 'Joined' | 'Dropped' — independent of `stage` because a
  /// candidate can be dropped/rejected at any stage, and an offer can be extended
  /// before the candidate is marked Onboarded (R5).
  status      String   @default("Active")
  dropReason  String?
  submittedAt String // ISO YYYY-MM-DD — when this candidate was sourced/submitted
  offeredAt   String? // ISO YYYY-MM-DD
  /// ISO YYYY-MM-DD — set when status becomes Joined or Dropped; the end of the
  /// candidate's turnaround-time window (closedAt - submittedAt = TAT).
  closedAt    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jdId])
  @@index([ownerName])
}

/// Client master list — grown organically as HDIS records are created/edited with a new
/// client name, and used to power the searchable client picker on the HDIS form.
model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  @@index([name])
}

model HdisOwner {
  id               String @id @default(cuid())
  jdId             String
  consultantOrName String
  hdis             Hdis   @relation(fields: [jdId], references: [jdId], onDelete: Cascade)

  @@index([jdId])
}

model HdisPipeline {
  jdId      String   @id
  r0        Int      @default(0)
  r1        Int      @default(0)
  r2        Int      @default(0)
  r3        Int      @default(0)
  r4        Int      @default(0)
  r5        Int      @default(0)
  stage     String
  updatedAt DateTime @updatedAt
  hdis      Hdis     @relation(fields: [jdId], references: [jdId], onDelete: Cascade)
}

model HdisAttachment {
  id          String   @id @default(cuid())
  jdId        String
  fileName    String
  storageKey  String
  contentType String
  size        Int
  uploadedBy  String
  at          DateTime @default(now())
  hdis        Hdis     @relation(fields: [jdId], references: [jdId], onDelete: Cascade)

  @@index([jdId])
}

model HdisActivity {
  id      String   @id @default(cuid())
  jdId    String
  actorId String
  action  String
  detail  String
  at      DateTime @default(now())
  hdis    Hdis     @relation(fields: [jdId], references: [jdId], onDelete: Cascade)
  actor   User     @relation(fields: [actorId], references: [id])

  @@index([jdId, at])
}

/// Records the first time each pipeline stage (R0-R5) for a requirement goes from a
/// zero headcount to a positive one — one row per jdId+stage, written inside
/// setPipeline(). This is the raw event data "profile aging" is computed from: the
/// time a requirement/profile took to move R0->R1, R1->R2, and so on.
model HdisStageEvent {
  id    String   @id @default(cuid())
  jdId  String
  stage String // 'R0' | 'R1' | 'R2' | 'R3' | 'R4' | 'R5'
  at    DateTime @default(now())
  hdis  Hdis     @relation(fields: [jdId], references: [jdId], onDelete: Cascade)

  @@unique([jdId, stage])
  @@index([jdId])
}

/// Platform-wide activity log — who did what, where. Written best-effort from route
/// handlers across modules (users, roles, clients, hdis, interviews); never blocks the
/// action it's logging. Distinct from HdisActivity, which is a per-record thread shown
/// on the HDIS detail page.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  section   String
  action    String
  detail    String
  entityId  String?
  at        DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([at])
  @@index([section, at])
}

/// KPI master list — the People Group's scorecard definitions (Trello planning,
/// profile-submission speed, HDIS discipline, etc). Super-admin managed; consultants
/// are measured against these but don't edit them.
model Kpi {
  id            String                @id @default(cuid())
  /// Display order / sheet row number — not a database identity, just the "KPI_no"
  /// column from the source scorecard so the table can be sorted the way HR expects.
  kpiNo         Int                   @unique
  symbol        String // short emoji/glyph shown next to the title
  title         String
  target        String // free text — thresholds vary in shape ("≥ 5 / day", "0", "100%")
  description   String
  /// 'Daily' | 'Weekly' | 'Monthly' | 'Quarterly' | 'Incidental' — kept as free text
  /// (validated at the API layer) rather than a DB enum so new cadences don't need a migration.
  periodicity   String
  whyItMatters  String?
  /// Links this KPI to a computed data source instead of manual entry, e.g.
  /// 'interviews_per_day' (counted live from the Interview table). Null for KPIs
  /// that aren't wired to an automated metric yet.
  trackedMetric String?
  /// Default per-consultant daily target for the tracked metric (e.g. 4 interviews/day).
  /// Individual consultants can override this via KpiConsultantTarget.
  numericTarget Int?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  targets       KpiConsultantTarget[]

  @@index([kpiNo])
}

/// Per-consultant override of a tracked KPI's numeric target (e.g. a senior consultant's
/// interviews/day target might be 5 instead of the KPI-wide default of 4).
model KpiConsultantTarget {
  id           String     @id @default(cuid())
  kpiId        String
  consultantId String
  target       Int
  updatedAt    DateTime   @updatedAt
  kpi          Kpi        @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@unique([kpiId, consultantId])
  @@index([kpiId])
}

/// Per-day self-logged activity for a consultant — events hosted/participated, insights,
/// and free-text remarks. Powers the "My activity" calendar on the consultant's own
/// Profile page (distinct from Consultant.eventsHosted/etc, which are lifetime totals).
model ConsultantLog {
  id                 String     @id @default(cuid())
  consultantId       String
  date               String // ISO YYYY-MM-DD
  eventsHosted       Int        @default(0)
  eventsParticipated Int        @default(0)
  insights           Int        @default(0)
  remarks            String?
  createdBy          String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  consultant         Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@index([consultantId, date])
  @@index([date])
}

model Interview {
  id              String           @id @default(cuid())
  date            String // ISO YYYY-MM-DD
  session         InterviewSession
  time            String?
  /// "RAPYD(F)" | "RAPYD(C)" | "Internal" — free text to match the HDIS Type picker
  /// without forcing a hard enum dependency between the two modules.
  type            String?
  candidate       String
  candidateEmail  String?
  ref             String? // interview update code, e.g. 2026090701
  round           String? // L0–L5
  client          String? // client name, from the Client master list
  profile         String? // role/position the candidate interviewed for — sourced from an HDIS record's title
  interviewer     String? // "With" — the interviewer's name
  requirementRef  String? // the HDIS jdId this interview's Profile was picked from
  ppgConsultantId String? // "Sourcing" — the PPG consultant running it
  stage           String?
  status          String?
  notes           String?
  createdBy       String
  createdAt       DateTime         @default(now())
  creator         User             @relation(fields: [createdBy], references: [id])

  @@index([date])
}
