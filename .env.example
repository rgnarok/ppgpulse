# ---- PPG Pulse server environment ----
# Copy to server/.env (and .env for docker compose) and fill in.

# Runtime
NODE_ENV=development
PORT=4000

# Database (Prisma). With docker compose: postgresql://ppg:ppg@localhost:5432/ppgpulse
DATABASE_URL=postgresql://ppg:ppg@localhost:5432/ppgpulse
# Separate database used by the automated test suite.
TEST_DATABASE_URL=postgresql://ppg:ppg@localhost:5432/ppgpulse_test

# Auth secrets — use long random strings in production (min 16 chars).
JWT_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# Access/refresh token lifetimes.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS — the web origin allowed to call the API.
WEB_ORIGIN=http://localhost:5173

# Local file storage root for HDIS attachments (dev StorageService).
UPLOAD_DIR=./uploads
# Max upload size in bytes (10 MB).
MAX_UPLOAD_BYTES=10485760

# ---- Outbound email (optional) ----
# Used to email newly-created users their login credentials. If SMTP_HOST is
# left unset, credential emails are silently skipped — user creation still
# works, just without the "email credentials" option actually sending mail.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PPG Pulse <no-reply@vayuz.com>"

# ---- Web (Vercel split deployment only) ----
# When the web app is hosted separately from the API (e.g. web on Vercel,
# API on Render), set this at build time to the API origin. Leave unset for
# single-origin deploys (API serves the web bundle).
# VITE_API_BASE_URL=https://ppg-api.onrender.com
